// 路由：输入用户问题，输出 {"route":"SYMBOLIC|TOOL|OPEN","confidence":0.0-1.0}
int ai_route(const char* question_utf8, char** result_json);

// 符号表达式语法校验：返回 {"valid":true|false,"normalized":"..."}
int ai_symbol_validate(const char* expr_utf8, char** result_json);

// 符号运算：返回 {"status":"OK|UNSUPPORTED|ERROR","value":"...","proof":"..."}
int ai_symbol_execute(const char* expr_utf8, char** result_json);

// 关键字提取（供“眨眼”压缩调用）：返回 {"keywords":["..."],"summary":"..."}
int ai_extract_keywords(const char* text_utf8, char** result_json);

// 开放域一致性校验：返回 {"consistent":true|false,"conflicts":["..."]}
int ai_consistency_check(const char* text_utf8, char** result_json);

// LLM 候选表达式验证闭环：返回 {"accepted":true|false,"value":"...","reason":"..."}
int ai_verify_candidate(const char* candidate_utf8, char** result_json);